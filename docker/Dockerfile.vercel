# syntax=docker/dockerfile:1
FROM kasmweb/ubuntu-noble-desktop:1.18.0 AS desktop

USER root
ENV DEBIAN_FRONTEND=noninteractive

# -----------------------------------------------------------------------------
# 1. CORE SYSTEM UTILITIES & C/C++
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    build-essential cmake pkg-config autoconf automake libtool \
    curl wget git unzip zip tar gzip \
    software-properties-common \
    libssl-dev zlib1g-dev libncurses5-dev libncursesw5-dev \
    libreadline-dev libsqlite3-dev libgdbm-dev libdb5.3-dev \
    libbz2-dev libexpat1-dev liblzma-dev libffi-dev uuid-dev \
    vim nano htop jq tree ripgrep bat fd-find nginx x11-utils \
    ffmpeg imagemagick \
    sqlite3 postgresql-client default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2. WINE (Windows .exe Support)
# -----------------------------------------------------------------------------
# 1. Enable 32-bit architecture
RUN dpkg --add-architecture i386

# 2. Install Wine and Winetricks dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wine \
    wine32 \
    wine64 \
    libwine \
    libwine:i386 \
    fonts-wine \
    cabextract \
    zenity \
    && rm -rf /var/lib/apt/lists/*

# 3. Install Winetricks
RUN curl -fsSL https://raw.githubusercontent.com/Winetricks/winetricks/master/src/winetricks -o /usr/local/bin/winetricks && \
    chmod +x /usr/local/bin/winetricks

# -----------------------------------------------------------------------------
# 3. PYTHON (Full Data Science & Web Stack)
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y python3-full python3-pip python3-dev python3-venv

# Avoid downloading uv for every ephemeral review workspace.
ARG UV_VERSION=0.12.24
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh

# FIX: Added --ignore-installed to handle 'blinker' and system package conflicts
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed \
    numpy pandas scipy matplotlib seaborn \
    scikit-learn pillow openpyxl \
    requests flask fastapi uvicorn django \
    boto3 sqlalchemy psycopg2-binary \
    pytest black flake8 ipython jupyterlab \
    beautifulsoup4 lxml pyyaml

# -----------------------------------------------------------------------------
# 4. NODE.JS, BUN, & TYPESCRIPT
# -----------------------------------------------------------------------------
# Install Node 22 (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# FIX: Bun installs directly to BUN_INSTALL, no need to move files
ENV BUN_INSTALL=/usr/local
RUN curl -fsSL https://bun.sh/install | bash

# Install Global NPM Tools
RUN npm install -g npm@latest \
    yarn pnpm \
    typescript ts-node \
    nodemon eslint prettier \
    @angular/cli react-scripts \
    express-generator

# -----------------------------------------------------------------------------
# 5. RUST
# -----------------------------------------------------------------------------
ENV RUSTUP_HOME=/opt/rust
ENV CARGO_HOME=/opt/rust
RUN mkdir -p /opt/rust && chmod -R 777 /opt/rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
ENV PATH="/opt/rust/bin:${PATH}"
RUN ln -s /usr/bin/batcat /usr/local/bin/bat && ln -s /usr/bin/fdfind /usr/local/bin/fd

# -----------------------------------------------------------------------------
# 6. GOLANG
# -----------------------------------------------------------------------------
ARG GO_VERSION=1.23.4
RUN rm -rf /usr/local/go && \
    curl -L https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# -----------------------------------------------------------------------------
# 7. JAVA (OpenJDK 21 + Maven + Gradle)
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y openjdk-21-jdk maven gradle \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 8. .NET 8.0 SDK
# -----------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 9. FINAL CLEANUP & PERMISSIONS
# -----------------------------------------------------------------------------
# Ensure kasm-user owns their home directory
RUN chown -R 1000:1000 /home/kasm-user

# Vercel does not execute image ENTRYPOINT/CMD. Start this explicitly after creation.
COPY sandbox/desktop-start.sh sandbox/bootstrap.sh /opt/airlock/
COPY sandbox/nginx.conf /opt/airlock/nginx.conf
COPY sandbox/wallpaper.svg /usr/share/backgrounds/verlock.svg
RUN convert -background none /usr/share/backgrounds/verlock.svg /usr/share/backgrounds/bg_default.png && \
    chmod +x /opt/airlock/*.sh && \
    mkdir -p /vercel/sandbox && chmod 1777 /vercel/sandbox && \
    echo 'kasm-user ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/kasm-nopasswd && \
    chmod 0440 /etc/sudoers.d/kasm-nopasswd
WORKDIR /vercel/sandbox
USER root
# Preserve the base image's startup settings when repacking its filesystem.
RUN python3 -c "import os,shlex; open('/opt/airlock/image-env.sh','w').write(''.join('export '+k+'='+shlex.quote(v)+'\\n' for k,v in os.environ.items() if k not in ('HOSTNAME','PWD','SHLVL','_')))"

# Kasm's upstream image contains a >2 GB compressed layer. VCR caps layers at
# 2 GB, so retain its filesystem while splitting it into smaller OCI layers.
FROM ubuntu:24.04
COPY --from=desktop /usr/bin/ /usr/bin/
COPY --from=desktop /usr/sbin/ /usr/sbin/
COPY --from=desktop --exclude=x86_64-linux-gnu --exclude=i386-linux-gnu /usr/lib/ /usr/lib/
COPY --from=desktop /usr/lib/x86_64-linux-gnu/ /usr/lib/x86_64-linux-gnu/
COPY --from=desktop /usr/lib/i386-linux-gnu/ /usr/lib/i386-linux-gnu/
COPY --from=desktop /usr/libexec/ /usr/libexec/
COPY --from=desktop /usr/local/ /usr/local/
COPY --from=desktop /usr/share/ /usr/share/
COPY --from=desktop /usr/include/ /usr/include/
COPY --from=desktop --exclude=bin --exclude=sbin --exclude=lib --exclude=local --exclude=share --exclude=include --exclude=libexec /usr/ /usr/
COPY --from=desktop /etc/ /etc/
COPY --from=desktop --exclude=rust /opt/ /opt/
COPY --from=desktop /opt/rust/ /opt/rust/
COPY --from=desktop /home/ /home/
COPY --from=desktop /root/ /root/
COPY --from=desktop /var/ /var/
COPY --from=desktop /dockerstartup/ /dockerstartup/
ENV HOME=/home/kasm-user USER=kasm-user DISPLAY=:1
ENV PATH="/opt/rust/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV BUN_INSTALL=/usr/local RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/rust
RUN mkdir -p /vercel/sandbox && chmod 1777 /vercel/sandbox
WORKDIR /vercel/sandbox
USER root
