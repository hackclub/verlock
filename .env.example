# Control plane only: never copy these credentials into a sandbox.
APP_SECRET=replace-with-a-random-session-signing-secret
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
# Gateway uses Vercel's OIDC token in production; key is optional locally.
AI_GATEWAY_API_KEY=
AI_MODEL=inclusionai/ling-3.1-flash
AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# For OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1, AI_API_KEY=...
AI_API_KEY=
BLOB_READ_WRITE_TOKEN=
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
# Seeds admins only when the canonical access list is first initialized.
ADMIN_USERS=
# Optional for a deployed control plane; locally, vc's saved login is used.
# Scope access to Hack Club when creating the token.
VERCEL_AUTH_TOKEN=
